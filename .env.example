# Copy this file to .env.local and fill in your keys.

# Required: Claude API key from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: which Claude model powers interviews and the persona.
ANTHROPIC_MODEL=claude-sonnet-5-5

# Required for voice cloning and spoken replies: https://elevenlabs.io (Settings > API Keys)
ELEVENLABS_API_KEY=
# Optional: ElevenLabs text-to-speech model.
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Optional: where the SQLite database and voice samples are stored (default: ./data)
DATA_DIR=

# Optional but strongly recommended before you put this on the internet:
# when set, the whole app asks for this password (HTTP basic auth, any username).
APP_PASSWORD=
